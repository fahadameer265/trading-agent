# Trading Agent — environment variables
# Copy this file to `.env` (same folder as config.py) and fill in real values.
# Never commit your real .env file to version control.

# Required for the sentiment node. Without it, sentiment defaults to NEUTRAL/0.5
# and the agent still runs (the LLM never decides the trade action).
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: DEBUG, INFO, WARNING, ERROR or CRITICAL (default: WARNING)
LOG_LEVEL=WARNING
